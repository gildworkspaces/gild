{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gild-import",
  "main": "services/import/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": true },
  "containers": [
    { "class_name": "ImportContainer", "image": "./services/import/Dockerfile", "max_instances": 10, "instance_type": "basic" }
  ],
  "durable_objects": { "bindings": [{ "name": "IMPORT_CONTAINER", "class_name": "ImportContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ImportContainer"] }]
}
